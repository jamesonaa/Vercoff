<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vercoff.ViewModels"
             x:Class="Vercoff.Views.CartPage"
             x:DataType="vm:CartViewModel"
             Title="My Cart"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource CreamBackground}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══════════ HEADER ═══════════ -->
        <Border Grid.Row="0" Padding="20,16"
                BackgroundColor="{StaticResource EspressoDark}"
                Stroke="Transparent" StrokeShape="RoundRectangle 0,0,0,0">
            <Label Text="🛒  My Cart"
                   FontFamily="PoppinsBold" FontSize="22"
                   TextColor="{StaticResource CreamBackground}" />
        </Border>

        <!-- ═══════════ EMPTY STATE ═══════════ -->
        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding HasItems, Converter={x:Null}}"
                             VerticalOptions="Center" HorizontalOptions="Center"
                             Spacing="12" x:Name="EmptyState">
            <Label Text="🪹" FontSize="60" HorizontalOptions="Center" />
            <Label Text="Your nest is empty!"
                   FontFamily="PoppinsSemiBold" FontSize="18"
                   TextColor="{StaticResource EspressoText}"
                   HorizontalOptions="Center" />
            <Label Text="Browse our menu to add some drinks"
                   Style="{StaticResource Caption}" FontSize="14"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- ═══════════ CART ITEMS LIST ═══════════ -->
        <ScrollView Grid.Row="1" IsVisible="{Binding HasItems}">
            <VerticalStackLayout Spacing="12" Padding="16,12">

                <!-- Cart Items -->
                <CollectionView ItemsSource="{Binding CartItems}"
                                ItemSizingStrategy="MeasureAllItems">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:Object">
                            <Border Margin="0,0,0,8"
                                    BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource LightCream}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14" Padding="12">
                                <Grid ColumnDefinitions="60,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                                    <!-- Image -->
                                    <Border Grid.RowSpan="3" Grid.Column="0"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="Transparent"
                                            HeightRequest="60" WidthRequest="60">
                                        <Image Source="{Binding MenuItem.ImageSource}"
                                               Aspect="AspectFill"
                                               HeightRequest="60" WidthRequest="60" />
                                    </Border>
                                    <!-- Name -->
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding MenuItem.Name}"
                                           FontFamily="PoppinsSemiBold" FontSize="14"
                                           TextColor="{StaticResource EspressoDark}" />
                                    <!-- Details -->
                                    <Label Grid.Row="1" Grid.Column="1"
                                           FontFamily="PoppinsRegular" FontSize="11"
                                           TextColor="{StaticResource SoftGray}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding SelectedSize}" />
                                                <Span Text=" · " />
                                                <Span Text="{Binding MilkChoice}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <!-- Price -->
                                    <Label Grid.Row="0" Grid.Column="2"
                                           Text="{Binding TotalPrice, StringFormat='₱{0:N0}'}"
                                           FontFamily="PoppinsBold" FontSize="15"
                                           TextColor="{StaticResource CaramelAccent}"
                                           VerticalOptions="Start" />
                                    <!-- Quantity Controls -->
                                    <HorizontalStackLayout Grid.Row="2" Grid.Column="1"
                                                           Spacing="8" Margin="0,6,0,0">
                                        <Button Text="−" WidthRequest="32" HeightRequest="32"
                                                CornerRadius="16" FontSize="16" Padding="0"
                                                BackgroundColor="{StaticResource LightCream}"
                                                TextColor="{StaticResource EspressoText}"
                                                FontFamily="PoppinsBold"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=DecrementQuantityCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Label Text="{Binding Quantity}"
                                               FontFamily="PoppinsBold" FontSize="15"
                                               VerticalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               WidthRequest="28"
                                               TextColor="{StaticResource EspressoDark}" />
                                        <Button Text="+" WidthRequest="32" HeightRequest="32"
                                                CornerRadius="16" FontSize="16" Padding="0"
                                                BackgroundColor="{StaticResource CaramelAccent}"
                                                TextColor="{StaticResource White}"
                                                FontFamily="PoppinsBold"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=IncrementQuantityCommand}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                    <!-- Remove -->
                                    <Label Grid.Row="2" Grid.Column="2"
                                           Text="🗑️" FontSize="16"
                                           VerticalOptions="End" HorizontalOptions="End">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=RemoveItemCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ═══ PROMO CODE ═══ -->
                <Border BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource LightCream}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Have a discount code?" Style="{StaticResource SubHeading}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0"
                                   Placeholder="e.g. DEFENSE20"
                                   Text="{Binding PromoCodeEntry}"
                                   FontFamily="PoppinsSemiBold" FontSize="14"
                                   BackgroundColor="{StaticResource LightCream}"
                                   HeightRequest="44" />
                            <Button Grid.Column="1" Text="Apply"
                                    Style="{StaticResource AddButton}"
                                    HeightRequest="44"
                                    Command="{Binding ApplyPromoCommand}" />
                        </Grid>
                        <Label Text="{Binding PromoError}"
                               TextColor="{StaticResource ErrorRed}"
                               FontFamily="PoppinsRegular" FontSize="12"
                               IsVisible="{Binding PromoError, Converter={x:Null}}"
                               x:Name="PromoErrorLabel" />
                        <HorizontalStackLayout IsVisible="{Binding ShowPromoSuccess}" Spacing="4">
                            <Label Text="✅" FontSize="14" />
                            <Label Text="{Binding AppliedPromoCode, StringFormat='Code {0} applied!'}"
                                   TextColor="{StaticResource SuccessGreen}"
                                   FontFamily="PoppinsSemiBold" FontSize="12" />
                            <Label Text="Remove" TextColor="{StaticResource ErrorRed}"
                                   FontFamily="PoppinsSemiBold" FontSize="12"
                                   TextDecorations="Underline">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RemovePromoCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══ ORDER SUMMARY ═══ -->
                <Border BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource LightCream}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Order Summary" Style="{StaticResource SubHeading}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Subtotal" Style="{StaticResource Caption}" FontSize="14" />
                            <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='₱{0:N0}'}"
                                   FontFamily="PoppinsSemiBold" FontSize="14"
                                   TextColor="{StaticResource EspressoText}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowPromoSuccess}">
                            <Label Text="Discount" TextColor="{StaticResource SuccessGreen}"
                                   FontFamily="PoppinsRegular" FontSize="14" />
                            <Label Grid.Column="1" Text="{Binding Discount, StringFormat='-₱{0:N0}'}"
                                   TextColor="{StaticResource SuccessGreen}"
                                   FontFamily="PoppinsSemiBold" FontSize="14" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource LightCream}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Total" FontFamily="PoppinsBold" FontSize="16"
                                   TextColor="{StaticResource EspressoDark}" />
                            <Label Grid.Column="1" Text="{Binding Total, StringFormat='₱{0:N0}'}"
                                   Style="{StaticResource PriceLabel}" FontSize="20" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Spacer for bottom button -->
                <BoxView HeightRequest="80" Color="Transparent" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══════════ CHECKOUT BUTTON ═══════════ -->
        <Border Grid.Row="2" Padding="16,12"
                BackgroundColor="{StaticResource CreamBackground}"
                Stroke="Transparent"
                IsVisible="{Binding HasItems}">
            <Button Text="{Binding Total, StringFormat='Proceed to Checkout — ₱{0:N0}'}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ProceedToCheckoutCommand}" />
        </Border>

    </Grid>

</ContentPage>
