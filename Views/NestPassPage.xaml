<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vercoff.ViewModels"
             x:Class="Vercoff.Views.NestPassPage"
             x:DataType="vm:NestPassViewModel"
             Title="Nest Pass"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource CreamBackground}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ═══════════ HEADER ═══════════ -->
            <Border Padding="20,16"
                    BackgroundColor="{StaticResource EspressoDark}"
                    Stroke="Transparent">
                <Label Text="⭐  Nest Pass"
                       FontFamily="PoppinsBold" FontSize="22"
                       TextColor="{StaticResource CreamBackground}" />
            </Border>

            <VerticalStackLayout Padding="16,20" Spacing="16">

                <!-- Hero Card -->
                <Border BackgroundColor="{StaticResource CaramelAccent}"
                        StrokeShape="RoundRectangle 20" Stroke="Transparent"
                        Padding="24">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label Text="🪺" FontSize="50" HorizontalOptions="Center" />
                        <Label Text="Ver's Nest Pass"
                               FontFamily="PoppinsBold" FontSize="26"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" />
                        <Label Text="Your weekly coffee subscription"
                               FontFamily="PoppinsRegular" FontSize="14"
                               TextColor="{StaticResource CreamBackground}"
                               HorizontalOptions="Center" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource White}" StrokeThickness="1"
                                BackgroundColor="Transparent"
                                Padding="16,8" HorizontalOptions="Center">
                            <Label Text="₱99 / week"
                                   FontFamily="PoppinsBold" FontSize="22"
                                   TextColor="{StaticResource White}"
                                   HorizontalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Status -->
                <Border BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource LightCream}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 16" Padding="20">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="{Binding StatusText}"
                               FontFamily="PoppinsSemiBold" FontSize="16"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource EspressoDark}" />
                        <Button Text="{Binding ButtonText}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ToggleSubscriptionCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Benefits List -->
                <Label Text="Member Benefits" Style="{StaticResource Heading}" Margin="0,8,0,0" />

                <Border BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource LightCream}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 16" Padding="20">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="☕" FontSize="24" />
                            <VerticalStackLayout>
                                <Label Text="15% OFF Every Order"
                                       FontFamily="PoppinsSemiBold" FontSize="14"
                                       TextColor="{StaticResource EspressoDark}" />
                                <Label Text="Use code NESTPASS15 at checkout"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1" Color="{StaticResource LightCream}" />

                        <HorizontalStackLayout Spacing="12">
                            <Label Text="🎂" FontSize="24" />
                            <VerticalStackLayout>
                                <Label Text="Free Birthday Drink"
                                       FontFamily="PoppinsSemiBold" FontSize="14"
                                       TextColor="{StaticResource EspressoDark}" />
                                <Label Text="Any drink, any size — on us!"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1" Color="{StaticResource LightCream}" />

                        <HorizontalStackLayout Spacing="12">
                            <Label Text="⚡" FontSize="24" />
                            <VerticalStackLayout>
                                <Label Text="Priority Queue"
                                       FontFamily="PoppinsSemiBold" FontSize="14"
                                       TextColor="{StaticResource EspressoDark}" />
                                <Label Text="Skip the line with express orders"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1" Color="{StaticResource LightCream}" />

                        <HorizontalStackLayout Spacing="12">
                            <Label Text="🎁" FontSize="24" />
                            <VerticalStackLayout>
                                <Label Text="Exclusive Seasonal Drinks"
                                       FontFamily="PoppinsSemiBold" FontSize="14"
                                       TextColor="{StaticResource EspressoDark}" />
                                <Label Text="Try new flavors before everyone else"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
